{
  "name": "zatom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.1"
  },
  "overrides": {
    "nanoid": "3.3.18"
  },
  "description": "Atomistic structure modeling and Agent tools for crystals, molecules, slabs, surfaces, and analysis.",
  "author": "zauq tech",
  "homepage": "https://github.com/DeepElectron/zatom-lite",
  "repository": {
    "type": "git",
    "url": "https://github.com/DeepElectron/zatom-lite.git"
  },
  "scripts": {
    "legal:generate": "node ./scripts/generate-third-party-notices.mjs",
    "prebuild": "npm run legal:generate",
    "dev": "vite --configLoader runner",
    "build": "node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "web:verify": "node ./scripts/verify-web-build.mjs",
    "lite:verify": "node ./scripts/verify-lite-boundary.mjs && node ./scripts/verify-english-comments.mjs",
    "comments:verify": "node ./scripts/verify-english-comments.mjs",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "test": "node ./scripts/run-modeler-tests.mjs && vitest run",
    "test:assert": "node ./scripts/run-modeler-tests.mjs",
    "test:vitest": "vitest run",
    "eval:scene-grid": "node --env-file-if-exists=.env.development.local --import tsx scripts/eval-scene-grid.mts"
  },
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.15.16",
    "buffer": "6.0.3",
    "clsx": "^2.1.1",
    "delaunator": "5.1.0",
    "framer-motion": "^11.18.2",
    "jsep": "^1.4.0",
    "jsonschema": "1.5.0",
    "ketcher-core": "3.17.2",
    "ketcher-react": "3.17.2",
    "ketcher-standalone": "3.17.2",
    "lucide-react": "^0.294.0",
    "mediabunny": "^1.54.0",
    "pdf-lib": "^1.17.1",
    "process": "0.11.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.15.4",
    "smiles-drawer": "^2.3.0",
    "tailwind-merge": "^3.5.0",
    "three": "0.160.0",
    "three-gpu-pathtracer": "0.0.23",
    "three-mesh-bvh": "0.7.8",
    "three-stdlib": "^2.36.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.7",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "24.13.3",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.160.0",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@vitejs/plugin-react": "6.0.5",
    "ai": "^7.0.90",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.10.3",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.23.7",
    "typescript": "^5.2.2",
    "vite": "8.2.0",
    "vitest": "^4.1.9",
    "webmcp-types": "^0.1.5"
  }
}
